@model List<PortalLL.Models.LicaoAprendida>
@{
    ViewData["Title"] = "Clarificar Lição Aprendida";
    var nomeUsuario = Context.Session.GetString("UsuarioNome");
    var usuarioId = Context.Session.GetInt32("UsuarioId");
    var usuarioNivel = Context.Session.GetString("UsuarioNivel");
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Clarificar uma Lição Aprendida</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            Nenhuma lição disponível para clarificação no momento.
        </div>
    }
    else
    {
        foreach (var licao in Model.Where(l => l.Status == PortalLL.Models.StatusLicao.Pendente || l.Status == PortalLL.Models.StatusLicao.Reprovada))
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@licao.Titulo</h5>
                    <p><strong>Descrição:</strong> @licao.Descricao</p>
                    <p><strong>Equipe:</strong> @licao.Equipe</p>
                    <p><strong>Software:</strong> @licao.Software</p>

                    <p><strong>Status:</strong> 
                        @if (licao.Status == PortalLL.Models.StatusLicao.Aprovada)
                        {
                            <span class="text-success font-weight-bold">Aprovada</span>
                        }
                        else if (licao.Status == PortalLL.Models.StatusLicao.Reprovada)
                        {
                            <span class="text-danger font-weight-bold">Reprovada</span>
                        }
                        else
                        {
                            <span class="text-warning font-weight-bold">Pendente</span>
                        }
                    </p>

                    <h6>Clarificações existentes:</h6>
                    @if (licao.Clarificacoes != null && licao.Clarificacoes.Any())
                    {
                        <ul>
                            @foreach (var item in licao.Clarificacoes)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p><em>Nenhuma clarificação ainda.</em></p>
                    }
                    @if ((usuarioNivel == "pleno" || usuarioNivel == "senior") && licao.UsuarioId != usuarioId)
                    {
                        <form asp-action="SalvarClarificacao" method="post" class="mt-3">
                            <input type="hidden" name="id" value="@licao.Id" />

                            <div class="form-group mb-2">
                                <textarea name="novaClarificacao" class="form-control" placeholder="Adicionar uma nova clarificação..." required></textarea>
                            </div>

                            <div class="d-flex justify-content-between">
                                <button type="submit" name="acao" value="aprovar" class="btn btn-success">✅ Aprovar</button>
                                <button type="submit" name="acao" value="reprovar" class="btn btn-danger">❌ Reprovar</button>
                                <button type="submit" name="acao" value="comentar" class="btn btn-primary">💬 Comentar</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted mt-2"><em>Apenas usuários Pleno ou Sênior e diferente do Criador da LL podem clarificar.</em></p>
                    }

                    @if (licao.Status == PortalLL.Models.StatusLicao.Reprovada && licao.UsuarioId == usuarioId)
                    {
                        <form asp-action="Editar" method="get" class="mt-3">
                            <input type="hidden" name="id" value="@licao.Id" />
                            <button type="submit" class="btn btn-warning">✏️ Editar</button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</div>
