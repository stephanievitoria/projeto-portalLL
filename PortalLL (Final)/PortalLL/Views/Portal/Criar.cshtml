@model PortalLL.Models.LicaoAprendida
@{
    ViewData["Title"] = "Criar LL";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criar Lição Aprendida</title>
</head>
<body style="margin: 0; font-family: Arial, sans-serif;">

    <div style="background-color: #003366; padding: 20px; height: 150px; width: 100%;">
        <h1 style="color: white; text-align: center;">Criar Lição Aprendida</h1>
    </div>

    <div style="display: flex; justify-content: center; padding: 40px;">
        <div style="width: 100%; max-width: 600px;">
            <h2 style="margin-bottom: 20px;">Preencha os detalhes da Lição Aprendida</h2>


            <form asp-action="Criar" method="post" style="display: flex; flex-direction: column; gap: 15px;">
                <div>
                    <label for="Titulo">Título:</label><br />
                    <input asp-for="Titulo" class="form-control" style="width: 100%; padding: 8px;" required />
                </div>

                <div>
                    <label for="DataHora">Data e Hora:</label><br />
                    <input asp-for="DataHora" type="datetime-local" class="form-control" style="width: 100%; padding: 8px;" required />
                </div>

                <div>
                    <label for="Equipe">Equipe:</label><br />
                    <input asp-for="Equipe" class="form-control" style="width: 100%; padding: 8px;" required />
                </div>

                <div>
                    <label for="software">Software</label>
                    <input type="text" class="form-control" id="software" name="software" required />
                </div>

                <div>
                    <label for="Descricao">Descrição do Problema:</label><br />
                    <textarea asp-for="Descricao" rows="5" class="form-control" style="width: 100%; padding: 8px;" required></textarea>
                </div>

                <button type="submit" style="padding: 10px; background-color: #003366; color: white; border: none; border-radius: 5px; cursor: pointer;">
                    Salvar
                </button>
            </form>
        </div>
    </div>

</body>
</html>
