@{
    ViewData["Title"] = "Login";
}
@if (TempData["Mensagem"] != null && TempData["Origem"]?.ToString() == "cadastro")
{
    <script>
        alert("@Html.Raw(TempData["Mensagem"].ToString().Replace("\"", "\\\""))");
    </script>
}

<h2 style="text-align: center;">Login</h2>

@if (TempData["ErroLogin"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["ErroLogin"]
    </div>
}


<form method="post" action="@Url.Action("Login", "Portal")" style="max-width: 400px; margin: 0 auto;">
    <div class="form-group mb-3">
        <label for="email">Email</label>
        <input type="email" class="form-control" id="email" name="email" required />
    </div>

    <div class="form-group mb-4">
        <label for="senha">Senha</label>
        <input type="password" class="form-control" id="senha" name="senha" required />
    </div>

    <div style="text-align: center;">
        <button type="submit" class="btn btn-primary px-4">Entrar</button>
    </div>
</form>
